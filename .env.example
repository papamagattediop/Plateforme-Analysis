# Copier ce fichier en .env

# Secrets
SECRET_KEY_IMPORT=changeme-import-secret-key
SECRET_KEY_ANALYSE=changeme-analyse-secret-key
SECRET_KEY_VISU=changeme-visu-secret-key

# Base de donnees (commune a tous les services)
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# URLs inter-services (Docker)
SERVICE_IMPORT_URL=http://service_import:8001
SERVICE_ANALYSE_URL=http://service_analyse:8002
SERVICE_VISU_URL=http://service_visu:8003

# Debug (mettre False en production)
DEBUG=True
